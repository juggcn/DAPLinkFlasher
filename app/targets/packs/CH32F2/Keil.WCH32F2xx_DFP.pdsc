   <!-- conditions section (optional for all Software Packs)-->
  <conditions>
	<condition id="Compiler ARM">
      <require Tcompiler="ARMCC"/>
    </condition>
	
	 <condition id="CH32F2xx">
      <description>WCH CH32F2xx Device</description>
      <require Dvendor="WCH:185" Dname="CH32F2*"/>
	  </condition>
	<condition id="CH32F2xx ARMCC">
      <description>filter for CH32F2xx Device and the ARM compiler</description>
      <require condition="CH32F2xx"/>
      <require Tcompiler="ARMCC"/>
    </condition>
	  
	 <condition id="CH32F2xx CMSIS">
      <description>WCH CH32F2xx Device with CMSIS</description>
      <require condition="CH32F2xx"/>
      <require Cclass="CMSIS" Cgroup="CORE"/>
    </condition>
	
	 <condition id="CH32F2xx STDPERIPH">
      <description>WCH CH32F2xx with Standard Peripherals Drivers Framework</description>
      <require condition="CH32F2xx CMSIS"/>
	  <require Cclass="CH32F2xx" Cgroup="Startup" />
      <require Cclass="CH32F2xx" Cgroup="StdPeriph Drivers" Csub="Framework"/>
    </condition>
	  <condition id="CH32F2xx STDPERIPH RCC">
      <description>WCH CH32F2xx with Standard Peripherals Drivers Framework and RCC</description>
      <require condition="CH32F2xx CMSIS"/>
      <require Cclass="CH32F2xx" Cgroup="StdPeriph Drivers" Csub="Framework"/>
      <require Cclass="CH32F2xx" Cgroup="StdPeriph Drivers" Csub="RCC"/>
    </condition>
  </conditions> 
  
  
  <!-- component section (optional for all Software Packs)config属性是可以更改内容的-->
	<components>
		
	    <component Cclass="CH32F2xx" Cgroup="Startup" Cversion="1.0.0" condition="CH32F2xx CMSIS">
      <description>System Startup for WCH CH32F2xx device series</description>
      <files>
        <!--  include folder -->
        <file category="include" name="Device/Include/"/>

        <!-- Flash Option Bytes templates -->
        <file category="source" name="Device/Source/ARM/CH32F2xx_OPT.s"      attr="template"  condition="Compiler ARM" select="Flash Option Bytes Template"/>

        <!-- startup files -->
        <file category="source" name="Device/Source/ARM/startup_ch32f20x_D8.s" attr="config" version="1.0.0" condition="CH32F2xx ARMCC"/>
        <!-- system file -->
        <file category="source" name="Device/Source/system_ch32f20x.c"            attr="config" version="1.0.0" />
       
      </files>
    </component>

    <!-- START: Standard Peripherals Drivers -->
    <!-- START: Standard Peripherals Drivers -->

    <component Cclass="CH32F2xx" Cgroup="StdPeriph Drivers" Csub="Framework" Cversion="1.0.0" condition="CH32F2xx STDPERIPH">
      <description>Standard Peripherals Drivers Framework</description>
      <files>
        <file category="include" name="Device/StdPeriph_Driver/inc/"/>
        <file category="header"  name="Device/StdPeriph_Driver/inc/ch32f20x_misc.h"/>
        <file category="source"  name="Device/StdPeriph_Driver/src/ch32f20x_misc.c"/>
        <file category="header"  name="Device/StdPeriph_Driver/templates/ch32f20x_conf.h" attr="config" version="1.0.0"/>
        <file category="header"  name="Device/StdPeriph_Driver/templates/ch32f20x_it.h"   attr="template" select="Interrupt Service Routines"/>
        <file category="source"  name="Device/StdPeriph_Driver/templates/ch32f20x_it.c"   attr="template" select="Interrupt Service Routines"/>
      </files>
    </component>

